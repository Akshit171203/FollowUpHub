# ========================
# FollowUpHub Backend — Environment Variables
# ========================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server
PORT=5001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/followuphub

# Cache (Redis)
REDIS_URL=redis://localhost:6381

# JWT Authentication
JWT_SECRET=CHANGE_ME_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Client URL (for CORS and email links)
CLIENT_URL=http://localhost:3000
# Server URL (for email verification links)
SERVER_URL=http://localhost:5001

# JWT Signing Keys (use strong random strings in production)
# LOGIN_SECRET_KEY signs short-lived (15m) access tokens. Refresh tokens are
# opaque random strings tracked in Redis (see modules/auth/services/token.service.js)
# and need no signing secret of their own.
LOGIN_SECRET_KEY=CHANGE_ME_login_secret_at_least_32_chars
EMAIL_TOKEN_SECRET=CHANGE_ME_email_token_secret_at_least_32_chars
RESET_PASSWORD_SECRET=CHANGE_ME_reset_password_secret_at_least_32_chars

# Encryption Key for Jira tokens (64-char hex string or 32-byte string)
ENCRYPTION_KEY=CHANGE_ME_64_char_hex_string_for_aes256

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5001/api/oauth/github/callback

# Slack (Webhook for escalations)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Gemini (AI-drafted follow-up messages) — get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
